{
  "name": "@[repo]/monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write '**/*.{ts,js,mjs}'",
    "release": "bumpp package.json packages/*/package.json --commit --push --tag",
    "test:ci": "turbo run test:ci",
    "typecheck": "turbo run typecheck",
    "preversion": "turbo run test:ci"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "bumpp": "latest",
    "prettier": "^3.10.1",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "turbo": "^2.11.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.23.0",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": ">=v24.0.0"
  }
}
