{
  "name": "@[repo]/monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write '**/*.{ts,js,mjs}'",
    "release": "bumpp package.json packages/*/package.json --commit --push --tag",
    "test:ci": "turbo run test:ci",
    "typecheck": "turbo run typecheck",
    "preversion": "turbo run test:ci"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "bumpp": "latest",
    "prettier": "^3.8.3",
    "tsdown": "^0.22.0",
    "tsx": "^4.22.2",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  },
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=v24.0.0"
  }
}
